# Generate both secrets before first boot; the app refuses to start while a
# value still begins with "change-me".
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=change-me-to-a-long-random-token
KEK_SECRET=change-me-to-a-long-random-encryption-secret
# Use an absolute path in production. A relative URL resolves against the
# process working directory, which silently creates an empty database when
# systemd starts the service from somewhere else.
DATABASE_URL=sqlite:///./linoi.db
